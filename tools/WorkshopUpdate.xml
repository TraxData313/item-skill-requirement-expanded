<Tasks>
    <GetItem>
        <!-- Updating the existing Workshop item ITEM_ID (to be created by WorkshopCreate.xml - replace ITEM_ID here
             and below with the new item's number after the first upload; make_workshop_update.py refuses until then).
             Not run directly: tools\make_workshop_update.py builds a task from it (adds ModuleFolder,
             the description, change notes, visibility). See tools\WORKSHOP-UPLOAD.md. -->
        <ItemId Value="ITEM_ID"/>
    </GetItem>
    <UpdateItem>
        <ModuleFolder Value="DIST_FOLDER"/>
        <ChangeNotes Value="vX.Y.Z - what changed." />
        <Tags>
            <Tag Value="Utility" />
            <Tag Value="Native" />
            <Tag Value="Singleplayer" />
            <Tag Value="v1.4.8" />
        </Tags>
    </UpdateItem>
</Tasks>
